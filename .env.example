# Copy this file to .env.local for local bot runs.
BOT_TOKEN=123456:replace_with_bot_token
ADMIN_IDS=123456789

# Optional in test payment mode.
PAYMENT_TEST_MODE=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Optional. Format: host:port@login:password
DEFAULT_MOBILE_PROXY=

# Optional. SmartParser/spfa.ru API key for automated Avito cookies.
SPFA_TOKEN=
SPFA_FULL_COOKIES=false

# Minimum seconds before reusing the same proxy/cookie channel.
MIN_CHANNEL_REUSE_SECONDS=60
